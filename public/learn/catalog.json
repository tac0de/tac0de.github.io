{
  "schemaVersion": 1,
  "tasks": [
    {
      "id": "relay-and",
      "version": "1.0.0",
      "track": "relay-input-state",
      "mode": "practice",
      "objective": "Write CSS that displays #lamp-on only when both A and B are checked. Otherwise its display must be none. Keep inputs and reset usable.",
      "assets": {
        "html": "relay.html",
        "starter": "starter.css"
      },
      "allowedEdits": [
        "submission.css"
      ],
      "evaluatorVersion": "relay-visibility-v1",
      "checks": {
        "form": "#exercise",
        "controls": [
          {
            "name": "A",
            "selector": "#input-a",
            "type": "checkbox",
            "defaultChecked": false
          },
          {
            "name": "B",
            "selector": "#input-b",
            "type": "checkbox",
            "defaultChecked": false
          }
        ],
        "outputs": [
          {
            "selector": "#lamp-on",
            "when": {
              "op": "AND",
              "args": [
                {
                  "input": "A"
                },
                {
                  "input": "B"
                }
              ]
            },
            "observable": "rendered-or-display-none"
          }
        ],
        "cases": "all-boolean-combinations",
        "reset": {
          "selector": "#reset",
          "expectedChecked": {
            "A": false,
            "B": false
          }
        },
        "observation": {
          "viewport": {
            "width": 800,
            "height": 600
          },
          "stableSamples": 3,
          "intervalMs": 100,
          "timeoutMs": 2000
        }
      }
    },
